[Unit]
Description=Hourly HeartWatch import from Dropbox

[Timer]
# Every hour, so a workout shows up soon after it syncs. Each poll fetches only
# new files. Persistent: if the server was off, poll once it's back.
OnCalendar=hourly
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
